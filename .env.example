# Local-only secrets. Never commit .env to GitHub.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_FROM=your_account@qq.com
SMTP_TO=you@example.com
SMTP_USER=your_account@qq.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
# Optional, only if the proven read-only market query requires an existing session:
# GPUSHARE_READ_COOKIE=...
# When anonymous market read fails, set in LOCAL .env only after rotating screenshot-exposed token:
# GPUSHARE_READ_AUTHORIZATION="Bearer YOUR_NEW_PRIVATE_TOKEN"

# Optional: "email control" (pause/resume monitoring by sending prefilled email).
# Requires IMAP access to the alert sender's inbox, not a public HTTP endpoint.
# IMAP_HOST=imap.qq.com
# IMAP_PORT=993
# IMAP_USER=your_account@qq.com
# IMAP_PASSWORD=YOUR_IMAP_APP_PASSWORD
# CONTROL_AUTHORIZED_FROM=your_notification_recipient@example.com
# CONTROL_SECRET=PASTE_RESULT_OF_PYTHON_SECRETS_TOKEN_URLSAFE_32
