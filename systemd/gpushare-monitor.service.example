[Unit]
Description=GPUShare read-only stock monitor and email alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_PROJECT_PATH
EnvironmentFile=REPLACE_PROJECT_PATH/.env
ExecStart=/usr/bin/python3 REPLACE_PROJECT_PATH/gpushare_monitor.py monitor --config REPLACE_PROJECT_PATH/config.json --state REPLACE_PROJECT_PATH/state/state.json
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
